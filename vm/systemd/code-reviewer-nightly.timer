# Starts the code reviewer's nightly run. Installed by vm/dev-vm-setup.sh.
[Unit]
Description=Code reviewer: start the nightly run

[Timer]
# Local time, in the machine's time zone (timedatectl). The time is a setting: run the setup with
# NIGHTLY_AT=HH:MM, which writes a drop-in over this line, and do not edit this file.
OnCalendar=*-*-* 02:00:00
# A night missed because the machine was off runs when the machine is next up.
Persistent=true

[Install]
WantedBy=timers.target
