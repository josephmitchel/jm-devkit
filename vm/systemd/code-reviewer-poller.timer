# Starts a pass of the code reviewer's poller every few minutes. Installed by vm/dev-vm-setup.sh.
[Unit]
Description=Code reviewer: start a pass of the poller

[Timer]
# The interval between passes. It is a setting: run the setup with POLL_EVERY=5min, which writes
# a drop-in over this line, and do not edit this file. Counted from when the last pass ended,
# however it ended, so a slow pass puts the next one back and passes never pile up.
OnUnitInactiveSec=3min
# The first pass after a boot, or after the timer is first turned on: there is no last pass to count from.
OnBootSec=1min
# A timer may otherwise be put back by up to a minute to share a wake-up.
AccuracySec=10s

[Install]
WantedBy=timers.target
