# One turn of the code reviewer's queue: start the next queued review, if no agent job is running
# on the machine, and see it through. Installed by vm/dev-vm-setup.sh. It has no timer: the
# poller's service starts it each time a pass ends (OnSuccess= and OnFailure= there), so a review
# a pass has just found starts at once, and one that had to wait is looked at again after the next
# pass. By hand: sudo systemctl start --no-block code-reviewer-queue.service
[Unit]
Description=Code reviewer: one turn of the queue of reviews
Wants=network-online.target
After=network-online.target postgresql.service
# As for the poller: not before the nightly run's update step has installed the dependencies once.
ConditionPathExists=/var/lib/code-reviewer/kit/reviewer/node_modules/.installed-from-lockfile
# Not while the nightly unit is active. Its update step replaces the code and the dependencies a
# review runs from, and the nightly run then has the machine until it is over. The directory is
# that unit's RuntimeDirectory=, there exactly as long as the unit is. A turn skipped this way is
# not a failure, and what was queued stays queued.
ConditionPathExists=!/run/code-reviewer-nightly

[Service]
# One turn and out. While it is going a second cannot start, so there is one review at a time.
Type=oneshot
User=reviewer
Group=reviewer

# The same credentials as the nightly run, from the same file only root can read.
EnvironmentFile=/etc/code-reviewer/credentials.env

# The same places as the nightly run (see code-reviewer-nightly.service).
StateDirectory=code-reviewer
StateDirectoryMode=0700
WorkingDirectory=/var/lib/code-reviewer/kit/reviewer
Environment=REVIEWER_WORKSPACE_ROOT=/var/lib/code-reviewer/workspaces
Environment=REVIEWER_STATE_DIR=/var/lib/code-reviewer/state
Environment="REVIEWER_GIT_NAME=jm-code-reviewer[bot]"
Environment="REVIEWER_GIT_EMAIL=338258166+jm-code-reviewer[bot]@users.noreply.github.com"

# No update step: a review runs whatever is checked out. Only the nightly run moves the checkout.
# Not through bin/code-reviewer.mjs: the process systemd signals must be the one that handles it.
ExecStart=/usr/bin/node --import tsx/esm src/cli.ts queue

# A review takes hours and has its own limit, kept by the code reviewer.
TimeoutStartSec=infinity
# On stop every process in the unit gets SIGTERM. The turn then records the review it was on as
# stopped, on the pull request too, which needs the time allowed here before anything left is killed.
KillMode=control-group
TimeoutStopSec=3min
