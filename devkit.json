{
  "$schema": "https://raw.githubusercontent.com/josephmitchel/jm-devkit/main/plugin/devkit.schema.json",
  "modules": [
    "process"
  ],
  "kit": "5322554396d8",
  "sweep": {
    "hour": 9
  },
  "reviewer": {
    "setup": "echo 'forced setup failure for #47: this pull request is never merged' && exit 1",
    "tests": [
      {
        "name": "reviewer",
        "command": "cd reviewer && DATABASE_URL=postgres://nobody@127.0.0.1:1/none npm test"
      },
      {
        "name": "plugin",
        "command": "node --test 'plugin/**/*.test.mjs'"
      },
      {
        "name": "apps-machine",
        "command": "node --test 'apps-machine/**/*.test.mjs'"
      }
    ]
  },
  "deploy": {
    "setup": "node sample-app/setup.mjs",
    "build": "node sample-app/build.mjs",
    "migrate": "node sample-app/migrate.mjs",
    "start": "exec node sample-app/server.mjs",
    "port": 4310,
    "healthPath": "/healthz"
  }
}
